# =============================================================================
# Archivos con credenciales — NUNCA subir a GitHub
# =============================================================================
.env
.env.*
!.env.example
conexion.php
config.php
db.php
admin.sql
*.pem
*.key

# =============================================================================
# PHP
# =============================================================================
/vendor
composer.phar
*.log

# =============================================================================
# Node / React / Next.js
# =============================================================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# build
/build
/dist

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =============================================================================
# Archivos pesados / ajenos al proyecto que no deben versionarse
# =============================================================================
img.zip
*.exe

# =============================================================================
# Documentos reales (PDFs) — se gestionan fuera de Git, solo se versiona
# la estructura de carpetas (.gitkeep). El código que los sirve
# (documento.php, index.html, etc.) NO se ve afectado por esta regla.
# =============================================================================
documentos/*
!documentos/.gitkeep
public/docs/*
!public/docs/.gitkeep
uploads/archivos/*
!uploads/archivos/.gitkeep

# =============================================================================
# Sistema operativo / editores
# =============================================================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/
.idea/
